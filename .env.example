# Qwen chat API (OpenAI-compatible endpoint). Ask the team for a real API key.
API_KEY=your_qwen_api_key_here
API_URL=https://deepcode.ci.nsu.ru/api/v1
MODEL=Qwen3.8-Flash-Next

# Local Qwen embeddings in LM Studio. The launcher configures its local endpoint.
EMBED_MODEL=qwen3-embedding-local

# Optional: set only when the selected Qwen deployment has vision support.
# By default vision inherits API_KEY, API_URL and MODEL.
# VISION_MODEL=Qwen3.8-Flash-Next
# VISION_API_URL=https://deepcode.ci.nsu.ru/api/v1
# VISION_API_KEY=your_qwen_api_key_here

# Request tuning
API_TIMEOUT=35
API_RETRIES=2
SEM_BATCH=8
SEM_CONC=8
EMB_BATCH=32
EMB_CONC=6
