# Leave empty to use local image heuristics.
# Set a real OpenAI-compatible key only when you want vision API scoring.
AI_API_KEY=
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini
PARSER_URL=http://localhost:8002/parse

# --- Neural Semantic API Settings ---
# Установи true, чтобы использовать API нейросети вместо локальных правил
USE_NEURAL_API=true

# Ключ от твоего провайдера (OpenAI, Yandex, Hugging Face, Local Ollama и т.д.)
NEURAL_API_KEY=your_api_key_here

# URL эндпоинта (пример для OpenAI)
NEURAL_API_URL=https://api.openai.com/v1/chat/completions

# Модель (пример для OpenAI)
NEURAL_MODEL=gpt-4o-mini

# Если используешь YandexGPT, URL будет другой, например:
# NEURAL_API_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
