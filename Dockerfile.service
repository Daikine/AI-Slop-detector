# Общий образ для сервисов. Сборка:
#   docker build -f Dockerfile.service --build-arg SERVICE=api-gateway -t slop/api-gateway .
FROM python:3.13-slim

WORKDIR /app

ARG SERVICE
ENV SERVICE=${SERVICE}

COPY services/${SERVICE}/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# копируем сервис и shared (контракты)
COPY services/${SERVICE}/ ./services/${SERVICE}/
COPY shared/ ./shared/
COPY ML/preprocess.py ./ML/preprocess.py
COPY tools/ ./tools/
